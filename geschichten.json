[{"slug":1,"datum":"2026-10-08","titel":" Wolfgarten Schulball 2026","teaser":"Ein besonderer Abend voller Musik, Spaß und gemeinsamer Erinnerungen.","veröffentlicht":true,"text":{"value":[{"@odata.etag":"\"33\"","ItemInternalId":"1","ID":1,"Title":" Wolfgarten Schulball 2026","Datum":"2026-10-08","Teaser":"Ein besonderer Abend voller Musik, Spaß und gemeinsamer Erinnerungen.","Text":"Der Wolfgarten-Schulball 2026 war ein besonderer Abend voller Musik, Tanz und guter Stimmung. Schülerinnen und Schüler, Lehrkräfte, Eltern und Gäste kamen zusammen und machten den Abend zu einem gemeinsamen Erlebnis. Zwischen festlicher Atmosphäre, kreativen Programmpunkten und vielen Gesprächen blieb vor allem eines: die Erinnerung an einen gelungenen Abend im Wolfgarten.","Ver_x00f6_ffentlicht":true,"Modified":"2026-10-08T15:12:35Z","Created":"2026-10-08T04:35:20Z","Author":{"@odata.type":"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedUser","Claims":"i:0#.f|membership|riegmich@wolfgarten.at","DisplayName":"Michael Riegler","Email":"riegmich@wolfgarten.at","Picture":"https://gymnasiumderdiozese.sharepoint.com/sites/LehrerInnenWolfgarten/_layouts/15/UserPhoto.aspx?Size=L&AccountName=riegmich@wolfgarten.at","Department":null,"JobTitle":null},"Author#Claims":"i:0#.f|membership|riegmich@wolfgarten.at","Editor":{"@odata.type":"#Microsoft.Azure.Connectors.SharePoint.SPListExpandedUser","Claims":"i:0#.f|membership|riegmich@wolfgarten.at","DisplayName":"Michael Riegler","Email":"riegmich@wolfgarten.at","Picture":"https://gymnasiumderdiozese.sharepoint.com/sites/LehrerInnenWolfgarten/_layouts/15/UserPhoto.aspx?Size=L&AccountName=riegmich@wolfgarten.at","Department":null,"JobTitle":null},"Editor#Claims":"i:0#.f|membership|riegmich@wolfgarten.at","{Identifier}":"Lists%252fAus%2bdem%2bWolfgarten%252f1_.000","{IsFolder}":false,"{Link}":"https://gymnasiumderdiozese.sharepoint.com/sites/LehrerInnenWolfgarten/_layouts/15/listform.aspx?PageType=4&ListId=a22502e4%2Db7b7%2D416e%2Da2e6%2D142bc02f4